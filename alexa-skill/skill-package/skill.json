{
  "manifest": {
    "manifestVersion": "1.0",
    "publishingInformation": {
      "locales": {
        "en-US": {
          "name": "Golfapalooza",
          "summary": "Listen to original Golfapalooza songs.",
          "description": "Play, shuffle, and request Golfapalooza songs by name. Try saying \"Alexa, open Golfapalooza\", \"Alexa, ask Golfapalooza to shuffle\", or \"Alexa, ask Golfapalooza to play [song name]\".",
          "examplePhrases": [
            "Alexa, open Golfapalooza",
            "Alexa, ask Golfapalooza to shuffle",
            "Alexa, ask Golfapalooza to play the Alpine Lake song"
          ],
          "keywords": [
            "golf",
            "music",
            "golfapalooza"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": [
        "US"
      ],
      "distributionMode": "PUBLIC",
      "category": "STREAMING_SERVICE",
      "testingInstructions": "Say \"open Golfapalooza\" to launch and start music."
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "arn:aws:lambda:us-east-1:679180307287:function:golfapalooza-alexa"
        },
        "interfaces": [
          {
            "type": "AUDIO_PLAYER"
          }
        ]
      }
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "locales": {
        "en-US": {
          "privacyPolicyUrl": "https://www.golfapalooza.app/privacy",
          "termsOfUseUrl": "https://www.golfapalooza.app/terms"
        }
      }
    }
  }
}